# Copy to .env and fill in ONE provider's key. .env is gitignored.
# LLM_PROVIDER: gemini | standin   (empty = auto: gemini if GEMINI_API_KEY is set)
LLM_PROVIDER=
GEMINI_API_KEY=
# LLM_OFFLINE=1 forbids any new model call; answers come from the committed cache.
LLM_OFFLINE=

# Model call limits
GEMINI_RPM=10
LLM_TIMEOUT_S=45
LLM_MAX_ATTEMPTS=4
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=30

# Service. API_KEY empty = no auth required. RATE_LIMIT_PER_MIN=0 disables limiting.
API_KEY=
RATE_LIMIT_PER_MIN=60

# Cost accounting, USD per million tokens. Left at 0 so no invented prices
# end up in a report; set them from your provider's pricing page.
COST_PER_MTOK_IN=0
COST_PER_MTOK_OUT=0

# --- Spend guard -------------------------------------------------------------
# Hard stop on live model calls per process. 0 disables. A full re-run of the
# dev iterations plus golden is roughly 6k calls.
LLM_MAX_CALLS=0

# --- Retrieval ---------------------------------------------------------------
# numpy: in-process brute force, no extra service, rebuilds the index on boot.
# qdrant: vectors live in Qdrant, so a scale-to-zero host has no 2-minute
#         cold start. Needs `pip install qdrant-client`.
RETRIEVAL_BACKEND=numpy
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=spotifycares_history
# 1 = exact search, identical top-k to numpy, committed LLM cache stays valid.
# 0 = HNSW, may reorder neighbours, which voids the committed golden numbers.
QDRANT_EXACT=1
